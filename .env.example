# Copy to .env for local development ONLY. Never commit .env.
# On Vercel, set these in Project -> Settings -> Environment Variables instead.

# Required. Create at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=your-key-here

# Required. Comma-separated list of website ORIGINS allowed to call the API.
# An origin is scheme + host only (no path, no trailing slash).
# Example: https://yourusername.github.io
ALLOWED_ORIGINS=https://yourusername.github.io

# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
